#!/usr/bin/env python3
"""Summarize eval results as Markdown tables.

Usage: eval/report [results-dir]
       eval/report --receipts [receipts-dir] [--exclude-task REGEX]

--receipts reads the delivery plugin's receipt store (default ${PASEO_HOME:-~/.paseo}/epistex-delivery)
and reports Lead-side handback metrics per Peer seat. It only reads the store.
"""
import argparse, json, os, pathlib, re, statistics, sys
from collections import Counter, defaultdict

HANDBACK_KINDS = ("HANDBACK_VALID", "TURN_ENDED_INVALID_HANDOFF", "TURN_ENDED_NO_MESSAGE")


def report_results(results):
    rows = sorted((json.loads(p.read_text()) for p in results.glob("*/result.json")), key=lambda r: (r["scenario"], r["provider"]))
    if not rows:
        sys.exit("no results")
    print("| Scenario | Provider | Status | Gate | fail-on-base | Outside scope | Full ran | Time (s) | Handoff (B) | Match |")
    print("|---|---|---|---|---|---|---|---|---|---|")
    for r in rows:
        print(f"| {r['scenario']} | {r['provider']} | {r['status']} | {r['gate']} | {r['fail_on_base'] or '-'} | "
              f"{len(r['outside_scope'])} | {'yes' if r['full_suite_ran'] else 'no'} | {r['duration_s']} | {r['handoff_bytes']} | "
              f"{'yes' if r['match'] else 'NO: ' + '; '.join(r['mismatches'])} |")
    agg = defaultdict(lambda: [0, 0, 0])
    for r in rows:
        a = agg[r["provider"]]
        a[0] += 1; a[1] += r["match"]; a[2] += r["duration_s"]
    print("\n| Provider | Runs | Match | Mean time (s) |\n|---|---|---|---|")
    for p, (n, ok, t) in sorted(agg.items()):
        print(f"| {p} | {n} | {ok}/{n} | {t // n} |")


def load_receipts(directory):
    """Receipt records by deliveryId; later `sent` update lines only change state."""
    records = {}
    for path in sorted(directory.glob("*.jsonl")):
        for line in path.read_text().splitlines():
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue  # torn last line after a crash
            if "kind" in item:
                records.setdefault(item["deliveryId"], item)
            elif item.get("deliveryId") in records:
                records[item["deliveryId"]]["state"] = item.get("state")
    return list(records.values())


def outcome_of(record):
    if record.get("outcome"):
        return record["outcome"]
    # Receipts written before the outcome field: invalid/no-message reasons start with the outcome.
    match = re.match(r"turn (completed|failed|canceled)\b", (record.get("reasons") or [""])[0])
    return match.group(1) if match else "unrecorded"


def report_receipts(directory, exclude):
    records = [r for r in load_receipts(directory) if r["kind"] in HANDBACK_KINDS]
    seats = defaultdict(list)
    for r in records:
        seats[(r["leadAgentId"], r["peerAgentId"])].append(r)
    if exclude:
        seats = {k: v for k, v in seats.items() if not any(r.get("taskId") and exclude.search(r["taskId"]) for r in v)}
    if not seats:
        sys.exit("no receipts")
    print("| Lead | Peer | Task | Receipts | Valid | Invalid | No message | Ends valid | Max body (B) |")
    print("|---|---|---|---|---|---|---|---|---|")
    kinds, outcomes, sizes, ends_valid = Counter(), Counter(), [], 0
    for (lead, peer), items in sorted(seats.items(), key=lambda kv: min(r["createdAt"] for r in kv[1])):
        items.sort(key=lambda r: r["createdAt"])
        count = Counter(r["kind"] for r in items)
        kinds.update(count)
        outcomes.update(outcome_of(r) for r in items)
        body = [len(r["body"].encode()) for r in items if r["body"]]
        sizes += body
        task = next((r["taskId"].strip("`") for r in items if r.get("taskId")), "?")
        last_valid = items[-1]["kind"] == "HANDBACK_VALID"
        ends_valid += last_valid
        print(f"| {lead[:8]} | {peer[:8]} | {task} | {len(items)} | {count['HANDBACK_VALID']} | "
              f"{count['TURN_ENDED_INVALID_HANDOFF']} | {count['TURN_ENDED_NO_MESSAGE']} | {'yes' if last_valid else 'no'} | "
              f"{max(body, default=0)} |")
    total = sum(kinds.values())
    print(f"\n| Metric | Value |\n|---|---|")
    print(f"| Peer seats | {len(seats)} |")
    print(f"| Handback receipts | {total} |")
    print(f"| Valid rate | {kinds['HANDBACK_VALID']}/{total} |")
    print(f"| Invalid receipts per seat (mean) | {kinds['TURN_ENDED_INVALID_HANDOFF'] / len(seats):.2f} |")
    print(f"| Seats whose last receipt is valid | {ends_valid}/{len(seats)} |")
    print(f"| Body size median / max (B) | {int(statistics.median(sizes)) if sizes else 0} / {max(sizes, default=0)} |")
    print(f"| Turn outcome | {', '.join(f'{k} {v}' for k, v in sorted(outcomes.items()))} |")


parser = argparse.ArgumentParser(description="Summarize eval results or delivery receipts as Markdown.")
parser.add_argument("results", nargs="?", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parent / "results")
parser.add_argument("--receipts", nargs="?", type=pathlib.Path, metavar="DIR",
                    const=pathlib.Path(os.environ.get("PASEO_HOME", "").strip() or "~/.paseo").expanduser() / "epistex-delivery")
parser.add_argument("--exclude-task", type=re.compile, metavar="REGEX", help="drop Peer seats with a matching task ID (smoke tests)")
args = parser.parse_args()
if args.receipts:
    report_receipts(args.receipts, args.exclude_task)
else:
    report_results(args.results)
