#!/usr/bin/env python3
"""Summarize eval results as Markdown tables.

Usage: eval/report [results-dir]
       eval/report --receipts [receipts-dir] [--agents FILE] [--include-test-seats] [--exclude-task REGEX]

--receipts reads the delivery plugin's receipt store (default ${PASEO_HOME:-~/.paseo}/epistex-delivery),
or a directory of eval/extract-receipts fixtures, and reports Lead-side handback metrics per Peer
seat, per model and per invalid reason code, and the early brief warnings (`BRIEF_INVALID`) the
Lead got for those seats. It only reads the receipts.
--agents is a JSON list of agents (id, provider, model, cwd) that names the Peer seat of each receipt.
Test seats are left out unless --include-test-seats is given: Peer cwd /tmp/epistex-live-*, or a
task ID T-<n>, MODE-OK or NO_SPIKE_TOOL.
"""
import argparse, json, os, pathlib, re, statistics, sys
from collections import Counter, defaultdict
import importlib.util
from importlib.machinery import SourceFileLoader


def load_script(name, path):
    """Import a kit script that has no .py suffix."""
    loader = SourceFileLoader(name, str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(module)
    return module

TEST_CWD = re.compile(r"^/tmp/epistex-live-")
TEST_TASK = re.compile(r"^`?(?:T-\d+|MODE-OK|NO_SPIKE_TOOL)`?$")

# A turn that was cut (failed, canceled) or left no message; PEER_REMINDED went to the Peer and is counted apart.
CUT_KINDS = ("TURN_ENDED_FAILED", "TURN_ENDED_CANCELED", "TURN_ENDED_NO_MESSAGE")
HANDBACK_KINDS = ("HANDBACK_VALID", "TURN_ENDED_INVALID_HANDOFF", *CUT_KINDS)


def report_results(results):
    rows = sorted((json.loads(p.read_text()) for p in results.glob("*/result.json")), key=lambda r: (r["scenario"], r["provider"]))
    if not rows:
        sys.exit("no results")
    print("| Scenario | Provider | Status | Gate | fail-on-base | Outside scope | Full ran | Time (s) | Handoff (B) | Match |")
    print("|---|---|---|---|---|---|---|---|---|---|")
    for r in rows:
        print(f"| {r['scenario']} | {r['provider']} | {r['status']} | {r['gate']} | {r['fail_on_base'] or '-'} | "
              f"{len(r['outside_scope'])} | {'yes' if r['full_suite_ran'] else 'no'} | {r['duration_s']} | {r['handoff_bytes']} | "
              f"{'yes' if r['match'] else 'NO: ' + '; '.join(r['mismatches'])} |")
    agg = defaultdict(lambda: [0, 0, 0])
    for r in rows:
        a = agg[r["provider"]]
        a[0] += 1; a[1] += r["match"]; a[2] += r["duration_s"]
    print("\n| Provider | Runs | Match | Mean time (s) |\n|---|---|---|---|")
    for p, (n, ok, t) in sorted(agg.items()):
        print(f"| {p} | {n} | {ok}/{n} | {t // n} |")


def load_receipts(directory):
    """Receipt records by deliveryId; later `sent` update lines only change state."""
    records = {}
    for path in sorted(directory.glob("*.jsonl")):
        for line in path.read_text().splitlines():
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue  # torn last line after a crash
            if "kind" in item:
                records.setdefault(item["deliveryId"], item)
            elif item.get("deliveryId") in records:
                records[item["deliveryId"]]["state"] = item.get("state")
    for path in sorted(directory.glob("*.json")):  # eval/extract-receipts fixtures
        item = json.loads(path.read_text())
        if isinstance(item, dict) and "kind" in item and "deliveryId" in item:
            records.setdefault(item["deliveryId"], item)
    return list(records.values())


def outcome_of(record):
    if record.get("outcome"):
        return record["outcome"]
    # Receipts written before the outcome field: invalid/no-message reasons start with the outcome.
    match = re.match(r"turn (completed|failed|canceled)\b", (record.get("reasons") or [""])[0])
    return match.group(1) if match else "unrecorded"


def codes_of(record):
    """Invalid reason codes; receipts written before the `codes` field get them from `reasons`."""
    if record["kind"] == "HANDBACK_VALID":
        return []
    if record.get("codes"):
        return record["codes"]
    text = "; ".join(record.get("reasons") or [])
    codes = ["TURN_CANCELED"] if "turn canceled" in text else []
    if record["kind"] == "TURN_ENDED_NO_MESSAGE":
        return codes + ["NO_MESSAGE"]
    if "handoff header" in text:
        codes.append("HEADER_MISSING")
    missing = re.search(r"missing cells: ([^;]*)", text)
    codes += ["CELL_MISSING:" + c.strip() for c in missing[1].split(",")] if missing else []
    if "Candidate cell needs" in text:
        codes.append("CANDIDATE_IDENTITY")
    return codes


def report_receipts(directory, exclude, agents, include_test_seats):
    everything = load_receipts(directory)
    records = [r for r in everything if r["kind"] in HANDBACK_KINDS]
    # One early warning per Peer whose brief failed check-brief; it is not a handback.
    early = [r for r in everything if r["kind"] == "BRIEF_INVALID"]
    seats = defaultdict(list)
    for r in records:
        seat = agents.get(r["peerAgentId"], {})
        for field in ("provider", "model", "cwd"):
            r[field] = r.get(field) or seat.get(field)
        seats[(r["leadAgentId"], r["peerAgentId"])].append(r)
    if not include_test_seats:
        seats = {k: v for k, v in seats.items()
                 if not any(TEST_CWD.search(r["cwd"] or "") or TEST_TASK.search(r.get("taskId") or "") for r in v)}
    if exclude:
        seats = {k: v for k, v in seats.items() if not any(r.get("taskId") and exclude.search(r["taskId"]) for r in v)}
    if not seats:
        sys.exit("no receipts")
    print("| Lead | Peer | Provider / model | Task | Receipts | Valid | Invalid | Cut / no message | Ends valid | Max body (B) |")
    print("|---|---|---|---|---|---|---|---|---|---|")
    kinds, outcomes, sizes, ends_valid = Counter(), Counter(), [], 0
    starts_valid, briefs, calls = 0, [], []
    classify = load_script("check_handoff", pathlib.Path(__file__).resolve().parents[1] / "setup/check-handoff").classify_handoff
    models, codes = defaultdict(Counter), Counter()
    for (lead, peer), items in sorted(seats.items(), key=lambda kv: min(r["createdAt"] for r in kv[1])):
        items.sort(key=lambda r: r["createdAt"])
        count = Counter(r["kind"] for r in items)
        kinds.update(count)
        outcomes.update(outcome_of(r) for r in items)
        body = [len(r["body"].encode()) for r in items if r["body"]]
        sizes += body
        model = f"{items[0]['provider'] or '?'} / {items[0]['model'] or '?'}"
        for r in items:
            models[model]["receipts"] += 1
            models[model]["valid"] += r["kind"] == "HANDBACK_VALID"
            # The plugin's test: a turn with a message is valid when the current parser accepts the body.
            models[model]["now"] += r["kind"] != "TURN_ENDED_NO_MESSAGE" and classify(r["body"])["valid"]
            codes.update(codes_of(r))
        task = next((r["taskId"].strip("`") for r in items if r.get("taskId")), "?")
        last_valid = items[-1]["kind"] == "HANDBACK_VALID"
        ends_valid += last_valid
        starts_valid += items[0]["kind"] == "HANDBACK_VALID"
        briefs += [r["briefCodes"] for r in items if "briefCodes" in r]  # plugin check of the Lead's brief
        if any("toolCalls" in r for r in items):
            calls.append(sum(r.get("toolCalls", 0) for r in items))
        print(f"| {lead[:8]} | {peer[:8]} | {model} | {task} | {len(items)} | {count['HANDBACK_VALID']} | "
              f"{count['TURN_ENDED_INVALID_HANDOFF']} | {sum(count[kind] for kind in CUT_KINDS)} | {'yes' if last_valid else 'no'} | "
              f"{max(body, default=0)} |")
    total = sum(kinds.values())
    print("\n| Provider / model | Receipts | Valid (recorded) | Valid (current parser) |\n|---|---|---|---|")
    for model, count in sorted(models.items()):
        print(f"| {model} | {count['receipts']} | {count['valid']} | {count['now']} |")
    print(f"| all | {total} | {kinds['HANDBACK_VALID']} | {sum(c['now'] for c in models.values())} |")
    if codes:
        print("\n| Invalid reason code (recorded) | Receipts |\n|---|---|")
        for code, count in sorted(codes.items(), key=lambda kv: (-kv[1], kv[0])):
            print(f"| {code} | {count} |")
    print(f"\n| Metric | Value |\n|---|---|")
    print(f"| Peer seats | {len(seats)} |")
    print(f"| Handback receipts | {total} |")
    print(f"| Valid rate | {kinds['HANDBACK_VALID']}/{total} |")
    print(f"| Invalid receipts per seat (mean) | {kinds['TURN_ENDED_INVALID_HANDOFF'] / len(seats):.2f} |")
    reminders = sum(r["kind"] == "PEER_REMINDED" and (r["leadAgentId"], r["peerAgentId"]) in seats for r in everything)
    print(f"| Turns bounced to the Peer (PEER_REMINDED) | {reminders} |")
    print(f"| Seats whose first receipt is valid | {starts_valid}/{len(seats)} |")
    print(f"| Seats whose last receipt is valid | {ends_valid}/{len(seats)} |")
    print(f"| Briefs that pass check-brief | {sum(not b for b in briefs)}/{len(briefs)} checked |")
    warned = [r for r in early if (r["leadAgentId"], r["peerAgentId"]) in seats]
    print(f"| Early brief warnings (BRIEF_INVALID) | {len(warned)} of {len(seats)} seats; "
          f"{len(early) - len(warned)} more for Peers not in this report |")
    brief_codes = Counter(code for r in warned for code in r.get("codes") or [])
    if brief_codes:
        print(f"| Early brief warning codes | {', '.join(f'{k} {v}' for k, v in sorted(brief_codes.items()))} |")
    print(f"| Tool calls per seat median / max | {int(statistics.median(calls)) if calls else 0} / {max(calls, default=0)} "
          f"({len(calls)} seats counted) |")
    print(f"| Body size median / max (B) | {int(statistics.median(sizes)) if sizes else 0} / {max(sizes, default=0)} |")
    print(f"| Turn outcome | {', '.join(f'{k} {v}' for k, v in sorted(outcomes.items()))} |")


parser = argparse.ArgumentParser(description="Summarize eval results or delivery receipts as Markdown.")
parser.add_argument("results", nargs="?", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parent / "results")
parser.add_argument("--receipts", nargs="?", type=pathlib.Path, metavar="DIR",
                    const=pathlib.Path(os.environ.get("PASEO_HOME", "").strip() or "~/.paseo").expanduser() / "epistex-delivery")
parser.add_argument("--agents", type=pathlib.Path, metavar="FILE", help="JSON list of agents: id, provider, model, cwd")
parser.add_argument("--include-test-seats", action="store_true", help="keep test seats in the receipt report")
parser.add_argument("--exclude-task", type=re.compile, metavar="REGEX", help="drop Peer seats with a matching task ID (smoke tests)")
args = parser.parse_args()
if args.receipts:
    agents = {a["id"]: a for a in json.loads(args.agents.read_text())} if args.agents else {}
    report_receipts(args.receipts, args.exclude_task, agents, args.include_test_seats)
else:
    report_results(args.results)
