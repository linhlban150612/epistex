{
  "_doc": [
    "Merge the three entries into .agents.providers; remove _doc and replace <KIT> with the absolute path.",
    "Lead/Peer use the project workspace. Supervisor uses ~/work/SUPERVISOR and must check its CWD.",
    "Credentials are shared from ~/.codex or EPISTEX_CODEX_HOME."
  ],
  "codex-lead": {
    "extends": "codex",
    "label": "Codex Lead Seat",
    "description": "Lead — framing, delegation, review and acceptance",
    "command": [
      "<KIT>/setup/codex-room",
      "lead"
    ],
    "env": {},
    "enabled": true,
    "paseoTools": {
      "enabled": true
    },
    "models": [
      {
        "id": "gpt-6.1-sol",
        "label": "GPT-6.1 Sol",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "low",
            "label": "Low",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "codex-peer": {
    "extends": "codex",
    "label": "Codex Peer Seat",
    "description": "Peer — implementation, evidence and handoff",
    "command": [
      "<KIT>/setup/codex-room",
      "peer"
    ],
    "env": {},
    "enabled": true,
    "paseoTools": {
      "enabled": false
    },
    "models": [
      {
        "id": "gpt-6-luna",
        "label": "GPT-6 Luna",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "low",
            "label": "Low",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "devin-supervisor": {
    "extends": "acp",
    "label": "Devin Supervisor Seat",
    "description": "Supervisor — Paseo-only cross-project observer",
    "command": [
      "<KIT>/setup/role-agent",
      "supervisor",
      "devin"
    ],
    "env": {},
    "enabled": true,
    "paseoTools": {
      "enabled": true
    },
    "models": [
      {
        "id": "fusion-claude-fable-5-1-medium-sidekick-swe-2-medium",
        "label": "Fusion (Claude Fable 5.1 Medium + SWE-2 Medium)",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "medium",
            "label": "Medium",
            "isDefault": true
          }
        ]
      }
    ]
  }
}
