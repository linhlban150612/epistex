{
  "_doc": [
    "Merge the two entries into .agents.providers; remove _doc and replace <KIT> with the absolute path.",
    "By default, use the workspace cwd; add EPISTEX_PROJECT_ROOT only when the project needs to be pinned.",
    "Credentials are shared from ~/.codex or EPISTEX_CODEX_HOME."
  ],
  "codex-lead": {
    "extends": "codex",
    "label": "Codex Lead Seat",
    "description": "Lead — framing, delegation, review and acceptance",
    "command": [
      "<KIT>/setup/codex-room",
      "lead"
    ],
    "env": {},
    "enabled": true,
    "paseoTools": {
      "enabled": true
    },
    "models": [
      {
        "id": "gpt-6.1-sol",
        "label": "GPT-6.1 Sol",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "low",
            "label": "Low",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "codex-peer": {
    "extends": "codex",
    "label": "Codex Peer Seat",
    "description": "Peer — implementation, evidence and handoff",
    "command": [
      "<KIT>/setup/codex-room",
      "peer"
    ],
    "env": {},
    "enabled": true,
    "paseoTools": {
      "enabled": false
    },
    "models": [
      {
        "id": "gpt-6-luna",
        "label": "GPT-6 Luna",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "low",
            "label": "Low",
            "isDefault": true
          }
        ]
      }
    ]
  }
}
