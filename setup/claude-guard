#!/usr/bin/env python3
"""Claude PreToolUse hook for a Peer seat: deny three destructive shell forms.

Usage: claude-guard   (PreToolUse JSON on standard input; `claude-sdk peer` registers it for `Bash`)

Exit code 2 denies the call, with the reason on standard error. The forms and their limits are in
`setup/seat_guard.py`; the workspace is `$CLAUDE_PROJECT_DIR`, else the Git top level of `cwd`.
"""

import json
import sys

from seat_guard import PEER_ADVICE, peer_reason


def main() -> int:
    try:
        call = json.load(sys.stdin)
        call["tool_name"]
    except (ValueError, KeyError, TypeError):
        sys.stderr.write("Epistex seat policy: unreadable PreToolUse input; tool call denied.\n")
        return 2
    reason = peer_reason(call, "Bash", "CLAUDE_PROJECT_DIR")
    if reason:
        sys.stderr.write(f"Epistex seat policy denies {reason} in a Peer seat. {PEER_ADVICE}\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
