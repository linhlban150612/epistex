#!/usr/bin/env bash
set -euo pipefail

role="${1:?room role is required}"
shift
case "$role" in
  supervisor|lead|peer) ;;
  *) printf 'invalid room role: %s\n' "$role" >&2; exit 2 ;;
esac

kit=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
project_root=${EPISTEX_PROJECT_ROOT:-${SEATWORKS_PROJECT_ROOT:-$PWD}}
project_root=$(cd -- "$project_root" && pwd -P)

# Only the documented direct UUID forms select a runtime across projects.
# Do not interpret prompts or option values as session IDs.
resume_id=
case "${1-}" in
  resume) resume_id=${2-} ;;
  exec|e) if [[ "${2-}" == resume ]]; then resume_id=${3-}; fi ;;
esac
if [[ ! "$resume_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  resume_id=
fi
runtime=$("$kit/setup/codex-room-sync" "$role" "$project_root" "$resume_id")

export CODEX_HOME="$runtime"
codex_bin=${CODEX_BIN:-$(command -v codex)}
cd -- "$project_root"
exec "$codex_bin" "$@"
