#!/usr/bin/env python3
"""Start a Cursor seat through cursor-agent ACP and inject role instructions into each ACP session."""

import importlib.machinery
import json
import os
import pathlib
import queue
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import uuid

sys.dont_write_bytecode = True
ROOT = pathlib.Path(__file__).resolve().parents[1]
ROLES = ("supervisor", "lead", "peer")
# Seat model ID -> the native ACP parameters the launcher sets, in this order, and confirms.
# A parameter that a model does not have (Composer: effort, context; Gemini: fast, context) is absent.
GROK = {"model": "grok-4.7", "fast": "false"}
MODELS = {
    "grok-4.7-medium-500k": {**GROK, "context": "500k", "reasoning_effort": "medium"},
    "grok-4.7-high-500k": {**GROK, "context": "500k", "reasoning_effort": "high"},
    "gemini-4-carbon-medium": {"model": "gemini-4-carbon", "reasoning_effort": "medium"},
    "gemini-4-carbon-high": {"model": "gemini-4-carbon", "reasoning_effort": "high"},
    "composer-2.5": {"model": "composer-2.5", "fast": "false"},
    "grok-4.7-low": {**GROK, "context": "256k", "reasoning_effort": "low"},
    "grok-4.7-medium": {**GROK, "context": "256k", "reasoning_effort": "medium"},
}
NAMES = {
    "grok-4.7-medium-500k": "Grok 4.7 medium, 500k (Fast off)", "grok-4.7-high-500k": "Grok 4.7 high, 500k (Fast off)",
    "gemini-4-carbon-medium": "Gemini 4 Carbon medium", "gemini-4-carbon-high": "Gemini 4 Carbon high",
    "composer-2.5": "Composer 2.5 (Fast off)",
    "grok-4.7-low": "Grok 4.7 low (Fast off)", "grok-4.7-medium": "Grok 4.7 medium (Fast off)",
}
# The models each role may select; the first is selected for a new or loaded session.
ROLE_MODELS = {
    "supervisor": ("grok-4.7-medium-500k", "grok-4.7-high-500k"),
    "lead": ("gemini-4-carbon-medium", "gemini-4-carbon-high"),
    "peer": ("composer-2.5", "grok-4.7-low", "grok-4.7-medium"),
}


def paseo_allow(role):
    """Permission tokens for the Paseo tools this role keeps, or [] for a Peer.

    Cursor ACP has no bypass mode: without them a Lead or Supervisor stops on a permission request at
    each Paseo call. The kept tools are the `@paseo/<tool>` entries of the Kiro agent file of the role.
    """
    if role == "peer":
        return []
    tools = json.loads((ROOT / f"setup/kiro-{role}.json").read_text())["tools"]
    return [f"Mcp(paseo:{tool.removeprefix('@paseo/')})" for tool in tools if tool.startswith("@paseo/")]


def run(role, args):
    """Translate the seat model IDs of this role into confirmed native ACP parameters."""
    allowed = ROLE_MODELS[role]
    role_agent = importlib.machinery.SourceFileLoader("role_agent", str(ROOT / "setup/role-agent")).load_module()
    role_agent.load_prompt(role)
    source = pathlib.Path(os.environ.get("CURSOR_CONFIG_DIR") or
                          (pathlib.Path(os.environ["XDG_CONFIG_HOME"]) / "cursor"
                           if os.environ.get("XDG_CONFIG_HOME") else pathlib.Path.home() / ".cursor"))
    # Cursor persists ACP model parameters in cli-config.json. Isolate that file,
    # but retain the original auth, MCP configuration and durable session stores.
    source.mkdir(parents=True, exist_ok=True)
    (source / "acp-sessions").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="epistex-cursor-") as folder:
        local = pathlib.Path(folder)
        for entry in source.iterdir():
            if entry.name not in ("cli-config.json", "acp-config.json"):
                (local / entry.name).symlink_to(entry.resolve())
        if (source / "cli-config.json").exists():
            shutil.copyfile(source / "cli-config.json", local / "cli-config.json")
            (local / "cli-config.json").chmod(0o600)
        allow = paseo_allow(role)
        if allow:
            # Only in the seat's private copy: the user's cli-config.json is not changed.
            try:
                config = json.loads((local / "cli-config.json").read_text())
            except (OSError, ValueError):
                config = {}
            if not isinstance(config, dict) or not isinstance(config.get("permissions", {}), dict):
                raise SystemExit("Cursor cli-config.json: permissions must be an object")
            permissions = config.setdefault("permissions", {})
            current = permissions.get("allow") if isinstance(permissions.get("allow"), list) else []
            permissions["allow"] = current + [token for token in allow if token not in current]
            (local / "cli-config.json").write_text(json.dumps(config))
            (local / "cli-config.json").chmod(0o600)
        child = subprocess.Popen(["cursor-agent", "acp", *args], stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, env={**os.environ, "CURSOR_CONFIG_DIR": folder})
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda signum, frame: child.send_signal(signum) if child.poll() is None else None)
        pending = {}
        pending_confirmation = {}
        lock = threading.Lock()
        primer = role_agent.Primer(role)
        selected = None
        sessions = set()
        confirmed = {}
        selection_lock = threading.RLock()

        def emit(message):
            with lock:
                print(json.dumps(message, ensure_ascii=False), flush=True)

        def send(message):
            child.stdin.write((json.dumps(message) + "\n").encode())
            child.stdin.flush()

        def reader():
            nonlocal selected
            for line in child.stdout:
                message = json.loads(line)
                waiter = pending.get(message.get("id")) if "method" not in message else None
                if waiter is not None:
                    confirmation = pending_confirmation.get(message.get("id"))
                    if confirmation and "error" not in message:
                        sid, model, expected = confirmation
                        result = message.get("result", {})
                        actual = {o.get("id"): o.get("currentValue")
                                  for o in result.get("configOptions", []) if isinstance(o, dict)}
                        with selection_lock:
                            if all(actual.get(key) == value for key, value in expected.items()):
                                selected = model
                                confirmed[sid] = model
                            else:
                                confirmed.pop(sid, None)
                                if selected == model:
                                    selected = None
                    waiter.put(message)
                else:
                    update = message.get("params", {}).get("update", {})
                    kind = update.get("sessionUpdate")
                    sid = message.get("params", {}).get("sessionId")
                    if kind in ("current_model_update", "config_option_update") and sid:
                        with selection_lock:
                            model = confirmed.get(sid)
                            if model:
                                expected = MODELS[model]
                                mismatch = False
                                if kind == "current_model_update":
                                    mismatch = update.get("currentModelId") != model
                                else:
                                    values = {o.get("id"): o.get("currentValue")
                                              for o in update.get("configOptions", []) if isinstance(o, dict)}
                                    mismatch = any(key in values and values[key] != value
                                                   for key, value in expected.items())
                                if mismatch:
                                    confirmed.pop(sid, None)
                                    if selected == model:
                                        selected = None
                        # Keep native model/config updates internal; selection confirmation is the public state.
                    else:
                        emit(message)
            for waiter in list(pending.values()):
                waiter.put({"error": {"code": -32603, "message": "Cursor exited before confirmation"}})

        output = threading.Thread(target=reader, daemon=True)
        output.start()

        def call(method, params, confirmation=None):
            ident = "epistex-cursor-" + uuid.uuid4().hex
            waiter = pending[ident] = queue.Queue()
            if confirmation:
                pending_confirmation[ident] = confirmation
            try:
                send({"jsonrpc": "2.0", "id": ident, "method": method, "params": params})
                response = waiter.get(timeout=40)
                if "error" in response:
                    raise ValueError(response["error"])
                return response["result"]
            finally:
                pending.pop(ident, None)
                pending_confirmation.pop(ident, None)

        def model_state():
            return {"currentModelId": selected, "availableModels": [
                {"modelId": model, "name": NAMES[model]} for model in allowed]}

        def options():
            return [{"id": "model", "name": "Model", "category": "model", "type": "select",
                     "currentValue": selected, "options": [
                         {"value": m["modelId"], "name": m["name"]}
                         for m in model_state()["availableModels"]]}]

        def choose(sid, model):
            nonlocal selected
            with selection_lock:
                confirmed.pop(sid, None)
                selected = None  # A partial or rejected selection must never allow a prompt.
            if model not in allowed:
                raise ValueError(f"Cursor {role} seat requires one of: " + ", ".join(allowed))
            expected = MODELS[model]
            for index, (key, value) in enumerate(expected.items()):
                confirmation = (sid, model, expected) if index == len(expected) - 1 else None
                result = call("session/set_config_option", {"sessionId": sid, "configId": key, "value": value},
                              confirmation)
            actual = {o["id"]: o["currentValue"] for o in result.get("configOptions", [])}
            if any(actual.get(key) != value for key, value in expected.items()):
                raise ValueError("Cursor did not confirm " + ", ".join(f"{k}={v}" for k, v in expected.items()))
            for session in sessions:
                emit({"jsonrpc": "2.0", "method": "session/update", "params": {
                    "sessionId": session, "update": {"sessionUpdate": "current_model_update", "currentModelId": model}}})

        try:
            for line in sys.stdin.buffer:
                message = json.loads(line)
                method, params = message.get("method"), message.get("params", {})
                try:
                    if method == "initialize":
                        caps = params.setdefault("clientCapabilities", {})
                        caps.setdefault("_meta", {})["parameterizedModelPicker"] = True
                        send(message)
                        continue
                    if method in ("session/new", "session/load"):
                        result = call(method, params)
                        sid = result.get("sessionId", params.get("sessionId"))
                        choose(sid, allowed[0])
                        sessions.add(sid)
                        if method == "session/load":
                            primer.restore(sid)
                        result["models"], result["configOptions"] = model_state(), options()
                    elif method == "session/set_model" or (method == "session/set_config_option" and params.get("configId") == "model"):
                        choose(params["sessionId"], params.get("modelId", params.get("value")))
                        result = {} if method == "session/set_model" else {"configOptions": options()}
                    elif method == "session/set_config_option" and params.get("configId") != "mode":
                        raise ValueError("Select a seat model; direct parameter changes are not allowed")
                    elif method == "session/prompt":
                        with selection_lock:
                            sid = params.get("sessionId")
                            if selected is None or sid not in sessions or confirmed.get(sid) != selected:
                                raise ValueError("Cursor model parameters are not confirmed; reselect a seat model")
                            child.stdin.write(role_agent.prime(line, primer))
                            child.stdin.flush()
                        continue
                    else:
                        send(message)
                        continue
                    emit({"jsonrpc": "2.0", "id": message["id"], "result": result})
                except (ValueError, queue.Empty) as error:
                    emit({"jsonrpc": "2.0", "id": message["id"], "error": {
                        "code": -32602, "message": "Cursor selection failed: " + str(error)}})
        finally:
            child.stdin.close()
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                child.terminate()
                child.wait(timeout=10)
            output.join(timeout=5)
    return child.returncode


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in ROLES:
        raise SystemExit("usage: cursor-acp <supervisor|lead|peer> [cursor-agent args...]")
    return run(sys.argv[1], sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
