#!/usr/bin/env python3
"""Droid PreToolUse hook: deny native subagents, missions, loops and automations in role seats.

Usage: droid-guard [supervisor|lead|peer]   (PreToolUse JSON on standard input)

Paseo owns agent lifecycle and topology, and roles create no schedules. Droid runs this hook for
direct tool calls and for each tool call inside a Script; exit code 2 rejects the call.
A Lead or Supervisor seat is also denied shell commands that commit, push, merge, remove a worktree
or deploy: the Peer is the only writer. The command check is a pattern match on the command text,
not a sandbox: it stops the usual forms, not a seat that hides the command.
"""

import json
import re
import sys

DENIED = {
    "Task", "TaskOutput", "TaskStop",
    "ProposeMission", "StartMissionRun",
    "Loop",
    "CreateAutomation", "EditAutomation", "DeleteAutomation", "RunAutomation",
}
# `git [-C dir] [-c k=v] [--opt[=v]] <subcommand>`; `merge-base` and `worktree list` stay allowed.
GIT_WRITE = re.compile(
    r"(?<![\w./-])git(?:\s+(?:-[Cc]\s+\S+|--?[\w-]+(?:=\S+)?))*\s+(commit|push|merge|worktree\s+remove)(?![\w-])")
# `<tool> [word] [word] deploy` at the start of a command: `modal deploy`, `npm run deploy`.
# Commands that only read text (`rg deploy docs`, `git log -- deploy`) stay allowed.
DEPLOY = re.compile(
    r"(?m)(?:^|[;&|(])\s*(?:\w+=\S*\s+)*(?!(?:rg|grep|cat|ls|echo|printf|find|head|tail|sed|awk|wc|git)\s)"
    r"[\w./-]+(?:\s+[\w./:=@-]+){0,2}?\s+deploy(?![\w./-])")


def denied_command(command: str) -> str | None:
    """The write action a Lead or Supervisor shell command would run, or None."""
    match = GIT_WRITE.search(command)
    if match:
        return "git " + " ".join(match.group(1).split())
    return "deploy" if DEPLOY.search(command) else None


def main() -> int:
    role = sys.argv[1] if len(sys.argv) > 1 else "peer"
    try:
        call = json.load(sys.stdin)
        name = call["tool_name"]
    except (ValueError, KeyError, TypeError):
        sys.stderr.write("Epistex seat policy: unreadable PreToolUse input; tool call denied.\n")
        return 2
    if name in DENIED:
        sys.stderr.write(f"Epistex seat policy denies {name}: Paseo owns agents, and roles create no schedules.\n")
        return 2
    command = call.get("tool_input", {}).get("command") if isinstance(call.get("tool_input"), dict) else None
    if role in ("lead", "supervisor") and name == "Execute" and isinstance(command, str):
        action = denied_command(command)
        if action:
            sys.stderr.write(f"Epistex seat policy denies {action} in a {role.capitalize()} seat: the Peer is the only "
                             "writer. Route the action to a Peer as an authority grant, or report BLOCKED.\n")
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
