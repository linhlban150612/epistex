#!/usr/bin/env python3
"""Seat-local Kiro CLI V3 ACP proxy. Never acknowledge unconfirmed mode, model, effort or tools."""
import json
import os
import pathlib
import queue
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
import uuid

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from role_prompt import Primer, load_prompt

ROOT = pathlib.Path(__file__).resolve().parents[1]
ROLE = "peer"
NAME = "Kiro Peer"
MODE = "epistex_peer"
# Exact Paseo 0.11 injection: {"type":"http","name":"paseo","url":"http://<loopback>:<port>
# /mcp/agents?callerAgentId=<id>","headers":[] or one Bearer Authorization header}.
PASEO_HOSTS = ("127.0.0.1", "localhost", "::1")
MODELS = ("claude-opus-5.5", "claude-sonnet-5.5")
EFFORTS = ("low", "medium")
# Standard V3 config options this seat exposes; every other option is hidden and immutable.
CHOICES = {"mode": (MODE,), "model": MODELS, "effortLevel": EFFORTS}
# Advertised V3 extensions the seat relays; workflows, memory, export etc. stay disabled.
EXTENSIONS = ("_kiro/session/context", "_kiro/session/compact")


def mcp_error(servers):
    """Peer accepts no MCP server; Lead accepts [] probes or Paseo's injected loopback server."""
    if ROLE == "peer":
        return "Kiro Peer does not accept injected MCP servers" if servers else None
    if (not isinstance(servers, list) or len(servers) > 1
            or (servers and not isinstance(servers[0], dict))):
        return "Kiro Lead requires an injected Paseo MCP server list"
    if not servers:
        return None  # Paseo probe session; prompts stay refused.
    server = servers[0]
    if (set(server) != {"type", "name", "url", "headers"} or server["type"] != "http"
            or server["name"] != "paseo" or not isinstance(server["url"], str)):
        return "Kiro Lead accepts only the Paseo HTTP MCP server"
    try:
        url = urllib.parse.urlsplit(server["url"])
        port = url.port
        query = urllib.parse.parse_qs(url.query, keep_blank_values=True, strict_parsing=True)
    except ValueError:
        return "Kiro Lead rejected a malformed Paseo MCP URL"
    if (url.scheme != "http" or url.hostname not in PASEO_HOSTS or port is None
            or url.username is not None or url.password is not None or url.path != "/mcp/agents"
            or url.fragment or set(query) != {"callerAgentId"}
            or len(query["callerAgentId"]) != 1 or not query["callerAgentId"][0]):
        return "Kiro Lead accepts only the loopback Paseo /mcp/agents endpoint"
    headers = server["headers"]
    if headers == []:
        return None
    if (not isinstance(headers, list) or len(headers) != 1 or not isinstance(headers[0], dict)
            or set(headers[0]) != {"name", "value"} or headers[0]["name"] != "Authorization"
            or not isinstance(headers[0]["value"], str) or not headers[0]["value"].startswith("Bearer ")
            or not headers[0]["value"][len("Bearer "):].strip()):
        return "Kiro Lead accepts only Paseo's bearer Authorization header"
    return None


def runtime_error(cwd):
    expected = (ROOT / f"setup/kiro-{ROLE}.json").read_bytes()
    installed = pathlib.Path.home() / f".kiro/agents/{MODE}.json"
    if installed.is_symlink() or not installed.is_file() or installed.read_bytes() != expected:
        return f"Install the exact seat-owned ~/.kiro/agents/{MODE}.json first"
    path = pathlib.Path(cwd)
    if not path.is_absolute() or not path.is_dir():
        return f"{NAME} requires an existing absolute CWD"
    for parent in (path, *path.parents):
        agents = parent / ".kiro/agents"
        if any(candidate != installed and (candidate.exists() or candidate.is_symlink())
               for candidate in (agents / (MODE + suffix) for suffix in (".json", ".md"))):
            return f"Workspace agent overrides the seat-owned {NAME} configuration"
    return None


def selected(options):
    """Current backend values of the options this seat controls."""
    return {o["id"]: o.get("currentValue") for o in options or [] if o.get("id") in CHOICES}


def visible(options):
    """Expose only the seat's mode/model/effort choices; hide autopilot, memory and other options."""
    shown = []
    for option in options or []:
        if option.get("id") in CHOICES:
            choices = CHOICES[option["id"]]
            shown.append({**option, "options": [o for o in option.get("options", [])
                                                if o.get("value") in choices]})
    return shown


def main():
    global ROLE, NAME, MODE, CHOICES
    if sys.argv[1:] not in (["peer"], ["lead"], ["supervisor"]):
        raise SystemExit("usage: kiro-acp <peer|lead|supervisor>")
    ROLE = sys.argv[1]
    NAME, MODE = "Kiro " + ROLE.title(), "epistex_" + ROLE
    CHOICES = {**CHOICES, "mode": (MODE,)}
    load_prompt(ROLE)  # Fail before starting the backend if the contract is unavailable.
    primer = Primer(ROLE)
    failure = runtime_error(str(pathlib.Path.cwd()))
    if failure:
        raise SystemExit(failure)
    # V3 rejects --agent/--model/--effort/--trust-*: mode goes in session/new, the rest via config options.
    child = subprocess.Popen(["kiro-cli", "acp", "--agent-engine=v3", "--auth-method=cli"],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    def stop(signum, _frame):
        if child.poll() is None:
            child.send_signal(signum)

    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, stop)
    events = queue.Queue()

    def reader(stream, source):
        buffered = b""
        while chunk := os.read(stream.fileno(), 65536):
            buffered += chunk
            while b"\n" in buffered:
                line, buffered = buffered.split(b"\n", 1)
                events.put((source, line))
        if buffered:
            events.put((source, buffered))
        events.put((source, None))

    for stream, source in ((sys.stdin.buffer, "client"), (child.stdout, "backend")):
        threading.Thread(target=reader, args=(stream, source), daemon=True).start()
    pending = {}
    forwarded = {}
    sessions = {}
    tags = {}
    mcp = {}
    stale = set()  # Sessions whose tag list predates their latest MCP snapshot.
    client_caps = {}
    agent_caps = {}
    # V3 advertises visible tools as tags: builtin categories plus "@paseo/<tool>" for MCP tools.
    declared = json.loads((ROOT / f"setup/kiro-{ROLE}.json").read_text())["tools"]
    required = {t for t in declared if t.startswith("@paseo/")}
    prefix = "epistex-" + uuid.uuid4().hex + "-"
    serial = 0

    def emit(message):
        sys.stdout.buffer.write((json.dumps(message, ensure_ascii=False) + "\n").encode())
        sys.stdout.buffer.flush()

    def send(message):
        if "method" in message and "id" in message and message["id"] not in pending:
            forwarded[message["id"]] = message
        child.stdin.write((json.dumps(message, ensure_ascii=False) + "\n").encode())
        child.stdin.flush()

    def error(request, text, code=-32602):
        if "id" in request:
            emit({"jsonrpc": "2.0", "id": request["id"],
                  "error": {"code": code, "message": text}})

    def internal(method, params, state):
        nonlocal serial
        serial += 1
        ident = prefix + str(serial)
        state["deadline"] = time.monotonic() + 30
        pending[ident] = state
        send({"jsonrpc": "2.0", "id": ident, "method": method, "params": params})

    def set_option(state, config_id, value):
        state["stage"], state["option"], state["value"] = "option", config_id, value
        internal("session/set_config_option",
                 {"sessionId": state["sid"], "configId": config_id, "value": value}, state)

    def valid(sid):
        current = sessions[sid]["current"]
        return all(current.get(key) in choices for key, choices in CHOICES.items())

    def inventory(sid):
        """"ok", "bad", or "wait" while Paseo's MCP server is still connecting."""
        advertised = tags.get(sid)
        if advertised is None:
            return "wait"
        if not set(advertised) <= set(declared):
            return "bad"
        if sessions.get(sid, {}).get("paseo") and not required <= set(advertised):
            status = [s.get("status") for s in mcp.get(sid, []) if s.get("name") == "paseo"]
            # Kiro reports "connected" before the didChange that carries the new @paseo/ tags.
            return "wait" if status in ([], ["connecting"]) or sid in stale else "bad"
        return "ok"

    def busy(sid):
        return any(s.get("sid") == sid for s in pending.values())

    def finish(state):
        """Answer a session/selection request only after mode/model/effort/tools are confirmed."""
        sid, request = state["sid"], state["request"]
        verdict = inventory(sid)
        if verdict == "wait":
            state["stage"] = "tools"
            state.setdefault("deadline", time.monotonic() + 30)
            pending[prefix + "tools-" + sid] = state
            return
        if verdict == "bad":
            error(request, f"Kiro exposed tools outside the {ROLE.title()} allowlist", -32603)
            return
        if not valid(sid):
            error(request, f"Kiro did not confirm the selected {NAME} mode/model/effort", -32603)
            return
        sessions[sid]["ready"] = True
        result = state["response"]
        result["configOptions"] = visible(sessions[sid]["options"])
        if "modes" in result:
            result["modes"]["availableModes"] = [
                m for m in result["modes"].get("availableModes", []) if m.get("id") == MODE]
        emit({"jsonrpc": "2.0", "id": request["id"], "result": result})

    def settle(state):
        """Validate a new/loaded session's model, then pin effort if it is outside the seat's choices."""
        sid = state["sid"]
        current = sessions[sid]["current"]
        if "model" not in current or "effortLevel" not in current:
            # Kiro can answer before its model catalog loads; the options arrive in config_option_update.
            state["stage"] = "options"
            pending[prefix + "options-" + sid] = state
        elif current["model"] not in MODELS:
            error(state["request"], "Kiro restored an unsupported mode/model", -32603)
        elif current["effortLevel"] not in EFFORTS:  # V3 defaults to "high"; pin the cheapest seat effort.
            set_option(state, "effortLevel", EFFORTS[0])
        else:
            finish(state)

    def revoke(sid):
        if sid in sessions and not busy(sid):
            del sessions[sid]
            send({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": sid}})

    def drop_sid(sid):
        sessions.pop(sid, None)
        tags.pop(sid, None)
        mcp.pop(sid, None)
        stale.discard(sid)
        for ident, state in list(pending.items()):
            if (state.get("sid") == sid
                    or state["request"].get("params", {}).get("sessionId") == sid):
                del pending[ident]

    def prompt_gate(sid):
        session = sessions.get(sid)
        if session and ROLE == "lead" and not session.get("paseo"):
            return "Kiro Lead session has no injected Paseo MCP server; prompts are refused"
        if (not session or not session.get("ready") or busy(sid) or not valid(sid)
                or inventory(sid) != "ok"):
            return f"{NAME} session/mode/model/effort/tool policy is not confirmed"
        return None

    try:
        while True:
            for ident, state in list(pending.items()):
                if time.monotonic() > state["deadline"]:
                    del pending[ident]
                    error(state["request"], "Kiro confirmation timed out", -32603)
            try:
                source, line = events.get(timeout=1)
            except queue.Empty:
                continue
            if line is None:
                if source == "backend":
                    for state in pending.values():
                        error(state["request"], "Kiro exited before responding", -32603)
                    for request in forwarded.values():
                        error(request, "Kiro exited before responding", -32603)
                    return child.wait()
                child.stdin.close()
                # Continue draining backend responses after client EOF.
                continue
            try:
                message = json.loads(line)
            except ValueError:
                emit({"jsonrpc": "2.0", "id": None,
                      "error": {"code": -32700, "message": "Parse error"}})
                continue
            method = message.get("method")
            params = message.get("params", {})
            if source == "client":
                sid = params.get("sessionId")
                if method == "initialize":
                    client_caps = params.get("clientCapabilities", {})
                    send(message)
                elif method in ("session/new", "session/load", "session/resume"):
                    failure = runtime_error(params.get("cwd", ""))
                    servers = mcp_error(params.get("mcpServers"))
                    if servers:
                        error(message, servers)
                    elif failure:
                        error(message, failure)
                    elif method == "session/load" and not agent_caps.get("loadSession"):
                        error(message, "Backend did not advertise session/load", -32601)
                    elif method == "session/resume":
                        drop_sid(sid)
                        send(message)
                    else:
                        if method == "session/load":
                            drop_sid(sid)
                        else:  # The seat agent is selected per session in V3, not by launch flag.
                            meta = params.setdefault("_meta", {}).setdefault("kiro", {})
                            meta["modeId"] = MODE
                        internal(method, params, {"request": message, "stage": "session",
                                                  "paseo": bool(params.get("mcpServers"))})
                elif method == "session/set_config_option":
                    config_id, value = params.get("configId"), params.get("value")
                    if sid not in sessions or config_id not in ("model", "effortLevel") or value not in CHOICES[config_id]:
                        error(message, f"Unsupported {NAME} selection")
                    elif busy(sid):
                        error(message, "Kiro selection already in progress")
                    else:
                        sessions[sid]["ready"] = False
                        state = {"request": message, "sid": sid, "response": {},
                                 "effort": sessions[sid]["current"].get("effortLevel")}
                        set_option(state, config_id, value)
                elif method in ("session/set_mode", "session/set_model"):
                    # V3 has no session/set_model; Paseo falls back to the advertised "model" option.
                    error(message, f"{NAME} has a fixed mode; select model/effort with session/set_config_option", -32601)
                elif method in EXTENSIONS:
                    if method not in agent_caps.get("_meta", {}).get("kiro", {}).get("extensionMethods", []):
                        error(message, f"Backend did not advertise {method}", -32601)
                    elif method == "_kiro/session/compact" and prompt_gate(sid):
                        error(message, prompt_gate(sid))
                    else:
                        send(message)
                elif method == "session/prompt":
                    if not isinstance(params.get("prompt"), list):
                        error(message, "session/prompt requires a prompt list")
                    elif prompt_gate(sid):
                        error(message, prompt_gate(sid))
                    else:
                        params["prompt"] = primer.prime(sid, params["prompt"])
                        send(message)
                elif method == "session/close":
                    drop_sid(sid)
                    send(message)
                elif method in ("session/cancel", "authenticate"):
                    send(message)
                elif method and (method.startswith("_session/") or method.startswith("_kiro")):
                    error(message, "Paseo owns lifecycle and topology; Kiro extension disabled", -32601)
                elif method is not None:
                    error(message, f"Unsupported {NAME} request: {method}", -32601)
                else:
                    send(message)
            else:
                if method and "id" in message:
                    supported = (method == "session/request_permission"
                                 and params.get("sessionId") in sessions)
                    if method in ("fs/read_text_file", "fs/write_text_file"):
                        key = "readTextFile" if method == "fs/read_text_file" else "writeTextFile"
                        supported = client_caps.get("fs", {}).get(key, False)
                    elif method.startswith("terminal/"):
                        supported = client_caps.get("terminal", False) and method in (
                            "terminal/create", "terminal/output", "terminal/release", "terminal/wait_for_exit", "terminal/kill")
                    if supported:
                        emit(message)
                    else:
                        send({"jsonrpc": "2.0", "id": message["id"], "error": {
                            "code": -32601, "message": "Unsupported agent-to-client request"}})
                elif method in ("_kiro/tools/didChange", "_kiro/mcp/status"):
                    sid = params.get("sessionId")
                    if method == "_kiro/mcp/status":
                        mcp[sid] = params.get("servers", [])  # Full snapshot, not an event.
                        stale.add(sid)
                    else:
                        tags[sid] = [t.get("tag") for t in params.get("tags", [])]
                        stale.discard(sid)
                    emit(message)
                    for ident, state in list(pending.items()):
                        if state.get("stage") == "tools" and state["sid"] == sid and inventory(sid) != "wait":
                            del pending[ident]
                            finish(state)
                    # An unsafe inventory update after confirmation revokes the session.
                    if sid in sessions and sessions[sid].get("ready") and inventory(sid) == "bad":
                        revoke(sid)
                elif method == "session/update" and params.get("update", {}).get("sessionUpdate") in (
                        "config_option_update", "current_mode_update"):
                    sid, update = params.get("sessionId"), params["update"]
                    if sid in sessions:
                        if "configOptions" in update:
                            sessions[sid]["options"] = update["configOptions"]
                            sessions[sid]["current"].update(selected(update["configOptions"]))
                        if "currentModeId" in update:
                            sessions[sid]["current"]["mode"] = update["currentModeId"]
                        if sessions[sid].get("ready") and not valid(sid):
                            revoke(sid)
                    if "configOptions" in update:
                        update["configOptions"] = visible(update["configOptions"])
                    emit(message)
                    waiting = pending.pop(prefix + "options-" + sid, None)
                    if waiting and sid in sessions:
                        settle(waiting)
                elif message.get("id") in pending:
                    ident = message["id"]
                    state = pending.pop(ident)
                    request = state["request"]
                    if state.get("sid") is not None and state["sid"] not in sessions:
                        continue
                    if "error" in message:
                        message["id"] = request["id"]
                        emit(message)
                    elif state["stage"] == "session":
                        result = message["result"]
                        sid = result.get("sessionId", request["params"].get("sessionId"))
                        sessions.pop(sid, None)
                        current = selected(result.get("configOptions"))
                        if result.get("modes", {}).get("currentModeId") != MODE or current.get("mode", MODE) != MODE:
                            error(request, "Kiro restored an unsupported mode/model", -32603)
                            continue
                        current["mode"] = MODE
                        sessions[sid] = {"paseo": state["paseo"], "options": result.get("configOptions", []),
                                         "current": current}
                        if request.get("method") == "session/load":
                            primer.restore(sid)
                        state.update(sid=sid, response=result)
                        settle(state)
                    elif state["stage"] == "option":
                        sid = state["sid"]
                        options = message["result"].get("configOptions")
                        if options is not None:
                            sessions[sid]["options"] = options
                            sessions[sid]["current"].update(selected(options))
                        current = sessions[sid]["current"]
                        if not state["response"]:
                            state["response"] = message["result"]
                        # V3 answers success while ignoring unknown values: confirm currentValue.
                        if current.get(state["option"]) != state["value"]:
                            error(request, f"Kiro did not confirm selected {state['option']}", -32603)
                        elif (state["option"] == "model" and state["effort"] in EFFORTS
                                and current.get("effortLevel") != state["effort"]):
                            set_option(state, "effortLevel", state["effort"])  # Keep effort across model changes.
                        else:
                            finish(state)
                else:
                    request = forwarded.pop(message.get("id"), None)
                    if request and request.get("method") == "initialize" and "result" in message:
                        agent_caps = message["result"].get("agentCapabilities", {})
                        kiro = agent_caps.get("_meta", {}).get("kiro", {})
                        if "extensionMethods" in kiro:  # Advertise only the extensions this seat relays.
                            message = json.loads(json.dumps(message))
                            visible_caps = message["result"]["agentCapabilities"]["_meta"]["kiro"]
                            visible_caps["extensionMethods"] = [m for m in kiro["extensionMethods"] if m in EXTENSIONS]
                    if not str(message.get("id", "")).startswith(prefix):
                        emit(message)
    finally:
        if child.poll() is None:
            child.terminate()
        child.wait()


if __name__ == "__main__":
    sys.exit(main())
