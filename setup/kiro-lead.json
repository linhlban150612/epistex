{
  "name": "epistex_lead",
  "description": "Epistex Lead; Paseo owns lifecycle and topology; Paseo MCP is injected per session",
  "model": "claude-opus-5.5",
  "tools": [
    "read",
    "write",
    "shell",
    "web",
    "@paseo/list_workspaces",
    "@paseo/list_providers",
    "@paseo/list_models",
    "@paseo/list_profiles",
    "@paseo/send_agent_prompt",
    "@paseo/cancel_agent",
    "@paseo/archive_agent",
    "@paseo/epistex_assign"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "paseo/list_workspaces",
          "paseo/list_providers",
          "paseo/list_models",
          "paseo/list_profiles",
          "paseo/send_agent_prompt",
          "paseo/cancel_agent",
          "paseo/archive_agent",
          "paseo/epistex_assign"
        ],
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false,
  "mcpServers": {},
  "resources": []
}
