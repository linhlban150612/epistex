{
  "name": "epistex_peer",
  "description": "Epistex Peer; Paseo owns lifecycle and topology",
  "model": "claude-sonnet-5.5",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false,
  "mcpServers": {},
  "resources": []
}
