#!/usr/bin/env python3
"""Start a role-configured agent; inject ACP instructions. Claude, Kiro, Amp, Devin, Copilot and Cursor use seat-local launchers."""

import json
import os
import pathlib
import shutil
import subprocess
import sys
import threading

ROOT = pathlib.Path(__file__).resolve().parents[1]
ROLES = ("supervisor", "lead", "peer")
ACP = {
    "agy": ["agy_acp_server.par", "--uid="],
    "glm": ["glm-acp-agent"],
    "droid": ["droid", "exec", "--output-format", "acp"],
}


def prime(line: bytes, role: str, seen: set[str]) -> bytes:
    try:
        message = json.loads(line)
    except (ValueError, UnicodeDecodeError):
        return line
    if not isinstance(message, dict) or message.get("method") != "session/prompt":
        return line
    params = message.get("params")
    if not isinstance(params, dict) or not isinstance(params.get("sessionId"), str):
        return line
    session = params["sessionId"]
    if session in seen:
        return line
    prompt = params.get("prompt")
    if not isinstance(prompt, list):
        return line
    instructions = (ROOT / "agents" / f"{role.upper()}.md").read_text()
    params["prompt"] = [{"type": "text", "text": "Role instructions for this session:\n" + instructions}, *prompt]
    seen.add(session)
    return (json.dumps(message, ensure_ascii=False) + "\n").encode()


def run_acp(command: list[str], role: str) -> int:
    if shutil.which(command[0]) is None:
        raise SystemExit(f"agent executable not found: {command[0]}")
    child = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE)

    def output() -> None:
        assert child.stdout is not None
        for line in child.stdout:
            sys.stdout.buffer.write(line)
            sys.stdout.buffer.flush()

    forwarding = threading.Thread(target=output)
    forwarding.start()
    assert child.stdin is not None
    seen: set[str] = set()
    try:
        for line in sys.stdin.buffer:
            child.stdin.write(prime(line, role, seen))
            child.stdin.flush()
    except BrokenPipeError:
        pass
    finally:
        child.stdin.close()
    forwarding.join()
    return child.wait()


def main() -> int:
    if len(sys.argv) < 3 or sys.argv[1] not in ROLES or sys.argv[2] not in (*ACP, "claude", "pi", "omp", "kiro", "amp", "devin", "copilot", "cursor"):
        raise SystemExit("usage: role-agent <supervisor|lead|peer> <claude|pi|omp|devin|copilot|cursor|amp|agy|glm|droid|kiro> (devin and copilot: peer only)")
    role, agent = sys.argv[1:3]
    if agent == "kiro":
        if role not in ("lead", "peer", "supervisor") or sys.argv[3:]:
            raise SystemExit("Kiro supports only the scoped Supervisor, Lead and Peer seats, without extra launch flags")
        os.execv(sys.executable, [sys.executable, str(ROOT / "setup/kiro-acp"), role])
    if agent == "claude":
        os.execv(sys.executable, [sys.executable, str(ROOT / "setup/claude-sdk"), role, *sys.argv[3:]])
    if agent in ("amp", "devin", "copilot", "cursor"):
        os.execv(sys.executable, [sys.executable, str(ROOT / f"setup/{agent}-acp"), role, *sys.argv[3:]])
    if agent in ("pi", "omp"):
        command = [agent, "--append-system-prompt", str(ROOT / "agents" / f"{role.upper()}.md"), *sys.argv[3:]]
        if shutil.which(command[0]) is None:
            raise SystemExit(f"agent executable not found: {command[0]}")
        os.execvp(command[0], command)
    return run_acp([*ACP[agent], *sys.argv[3:]], role)


if __name__ == "__main__":
    sys.exit(main())
