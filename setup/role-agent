#!/usr/bin/env python3
"""Start a role-configured agent; inject ACP instructions. Claude, Kiro, Amp, Devin, Copilot and Cursor use seat-local launchers."""

import json
import os
import pathlib
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from role_prompt import Primer, load_prompt

ROOT = pathlib.Path(__file__).resolve().parents[1]
ROLES = ("supervisor", "lead", "peer")
ACP = {
    "agy": ["agy_acp_server.par", "--uid="],
    "droid": ["droid", "exec", "--output-format", "acp"],
}


def prime(line: bytes, primer: Primer, cwd: str | None = None) -> bytes:
    try:
        message = json.loads(line)
    except (ValueError, UnicodeDecodeError):
        return line
    method = message.get("method") if isinstance(message, dict) else None
    if method not in ("session/prompt", "session/load", "session/resume"):
        return line
    params = message.get("params")
    if not isinstance(params, dict) or not isinstance(params.get("sessionId"), str):
        return line
    if method != "session/prompt":
        primer.restore(params["sessionId"])
        return line
    prompt = params.get("prompt")
    if not isinstance(prompt, list):
        return line
    primed = primer.prime(params["sessionId"], prompt, cwd)
    if primed is prompt:
        return line
    params["prompt"] = primed
    return (json.dumps(message, ensure_ascii=False) + "\n").encode()


def session_cwd(line: bytes) -> str | None:
    try:
        message = json.loads(line)
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(message, dict) or message.get("method") not in ("session/new", "session/load", "session/resume"):
        return None
    params = message.get("params")
    cwd = params.get("cwd") if isinstance(params, dict) else None
    return cwd if isinstance(cwd, str) else None


def omp_args(role: str, args: list[str]) -> list[str]:
    """Combine OMP's last-wins append flag while preserving its text/file inputs."""
    append_values = []
    forwarded = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            forwarded.extend(args[index:])
            break
        if arg == "--append-system-prompt" and index + 1 < len(args):
            append_values.append(args[index + 1])
            index += 2
            continue
        if arg.startswith("--append-system-prompt="):
            append_values.append(arg.split("=", 1)[1])
            index += 1
            continue
        forwarded.append(arg)
        index += 1

    parts = []
    for value in append_values:
        # OMP resolves a newline-free append value as a file when it can read
        # that path; otherwise it treats the value as literal prompt text.
        if "\n" not in value:
            try:
                value = pathlib.Path(value).read_text()
            except (OSError, UnicodeError):
                pass
        if value:
            parts.append(value)
    parts.append(load_prompt(role))
    combined = "\n\n".join(parts)
    return ["--append-system-prompt", combined, *forwarded]


def run_acp(command: list[str], role: str, pin_cwd: bool = False) -> int:
    load_prompt(role)  # Fail before starting a backend if the contract is unavailable.
    if shutil.which(command[0]) is None:
        raise SystemExit(f"agent executable not found: {command[0]}")
    child = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE)

    def output() -> None:
        assert child.stdout is not None
        for line in child.stdout:
            sys.stdout.buffer.write(line)
            sys.stdout.buffer.flush()

    forwarding = threading.Thread(target=output)
    forwarding.start()
    assert child.stdin is not None
    primer = Primer(role)
    cwd = None
    try:
        for line in sys.stdin.buffer:
            if pin_cwd:
                cwd = session_cwd(line) or cwd
            child.stdin.write(prime(line, primer, cwd))
            child.stdin.flush()
    except BrokenPipeError:
        pass
    finally:
        child.stdin.close()
    forwarding.join()
    return child.wait()


def main() -> int:
    if len(sys.argv) < 3 or sys.argv[1] not in ROLES or sys.argv[2] not in (*ACP, "claude", "pi", "omp", "kiro", "amp", "devin", "copilot", "cursor"):
        raise SystemExit("usage: role-agent <supervisor|lead|peer> <claude|pi|omp|devin|copilot|cursor|amp|agy|droid|kiro> (devin and copilot: peer only)")
    role, agent = sys.argv[1:3]
    if agent == "kiro":
        if role not in ("lead", "peer", "supervisor") or sys.argv[3:]:
            raise SystemExit("Kiro supports only the scoped Supervisor, Lead and Peer seats, without extra launch flags")
        os.execv(sys.executable, [sys.executable, str(ROOT / "setup/kiro-acp"), role])
    if agent == "claude":
        os.execv(sys.executable, [sys.executable, str(ROOT / "setup/claude-sdk"), role, *sys.argv[3:]])
    if agent in ("amp", "devin", "copilot", "cursor"):
        os.execv(sys.executable, [sys.executable, str(ROOT / f"setup/{agent}-acp"), role, *sys.argv[3:]])
    if agent == "omp":
        command = ["omp", *omp_args(role, sys.argv[3:])]
        if shutil.which(command[0]) is None:
            raise SystemExit(f"agent executable not found: {command[0]}")
        os.execvp(command[0], command)
    if agent == "pi":
        command = [agent, "--append-system-prompt", load_prompt(role), *sys.argv[3:]]
        if shutil.which(command[0]) is None:
            raise SystemExit(f"agent executable not found: {command[0]}")
        os.execvp(command[0], command)
    # The Antigravity server runs shell commands in its own skills directory, not the session cwd.
    return run_acp([*ACP[agent], *sys.argv[3:]], role, pin_cwd=agent == "agy")


if __name__ == "__main__":
    sys.exit(main())
